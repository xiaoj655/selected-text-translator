{
  "manifest_version": 3,
  "name": "Selected Text Translator",
  "version": "0.9.0",
  "description": "Read with context: translate, listen, and discover meaning through gentle English hints.",
  "permissions": [
    "storage",
    "tts"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/options.html",
  "action": {
    "default_title": "Selected Text Translator",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/icon.svg"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "open-reading-assistant": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Open the reading assistant for selected text"
    }
  }
}
