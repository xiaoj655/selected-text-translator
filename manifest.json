{
  "manifest_version": 3,
  "name": "Selected Text Translator",
  "version": "0.7.2",
  "description": "Read with context: translate, listen, and discover meaning through gentle English hints.",
  "permissions": [
    "storage",
    "tts"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/options.html",
  "action": {
    "default_title": "Selected Text Translator",
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "assets/icon128.png"
  },
  "commands": {
    "open-reading-assistant": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Open the reading assistant for selected text"
    }
  }
}
