{
  "name": "selected-text-translator-desktop",
  "version": "0.9.97",
  "private": true,
  "type": "module",
  "description": "Desktop build of the selected text reading assistant",
  "author": "xiaoj655",
  "main": "src/main.js",
  "scripts": {
    "sync": "node scripts/sync-src.mjs",
    "presmoke": "node scripts/sync-src.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify": "node scripts/verify.mjs && npm run test:e2e",
    "test:e2e": "npm run sync && node scripts/e2e.mjs",
    "test:icons": "node scripts/verify-icons.mjs",
    "test:e2e:visual": "npm run sync && node scripts/e2e-visual.mjs",
    "test:e2e:live": "npm run sync && node scripts/e2e-live.mjs",
    "test:e2e:live:sentence": "npm run sync && node scripts/e2e-live-sentence.mjs",
    "test:e2e:live:reading": "npm run sync && node scripts/e2e-live-reading.mjs",
    "test:live:languages": "node scripts/verify-live-languages.mjs",
    "test:live:languages:zh": "node scripts/verify-live-languages-zh.mjs",
    "test:e2e:resolutions": "npm run sync && node scripts/e2e-resolutions.mjs",
    "start": "npm run sync && electron .",
    "predist": "node scripts/sync-src.mjs",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "electron-updater": "^6.8.12",
    "ipaddr.js": "^2.5.0",
    "linkedom": "^0.18.15",
    "parse5": "^8.1.1",
    "sanitize-html": "^2.18.2"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.xiaoj655.selected-text-translator",
    "productName": "Selected Text Translator",
    "icon": "assets/icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "assets/*.ico",
      "assets/*.png",
      "src/**/*",
      "app/**/*",
      "vendor/**/*"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "publish": {
        "provider": "generic",
        "url": "https://github.com/xiaoj655/selected-text-translator/releases/download/desktop-v${version}/"
      }
    },
    "nsis": {
      "artifactName": "Selected.Text.Translator.Setup.${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "dir",
        "AppImage"
      ],
      "category": "Utility"
    },
    "publish": null
  }
}
